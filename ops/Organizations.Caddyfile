{
    email {$CORE_ORGANIZATION_TLS_EMAIL}
}

import OrganizationRoutes.caddy

{$CORE_ORGANIZATION_DOMAIN} {
    encode zstd gzip
    header {
        -Server
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    import organization_routes
}
