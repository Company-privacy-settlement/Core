# Two different DNS names pointing to the selected host. No credentials in this file.
CORE_API_DOMAIN=api.example.com
CORE_ORGANIZATION_DOMAIN=organizations.example.com
CORE_TLS_EMAIL=operator@example.com
CORE_ALLOWED_ORIGINS=https://core-private-settlement-0574c4.jiheon6768.chatgpt.site
CORE_RPC_URL=https://rpc.testnet.near.org
# Real independently verified keyless testnet deployment; examples are not deployable.
CORE_POLICY_PATH=/secure/core/trusted-policy.json
CORE_POLICY_SHA256=REPLACE_WITH_EXACT_POLICY_FILE_BYTE_SHA256
# Provision on the host, owner-only and readable by runtime UID 1000; back up separately.
CORE_ORGANIZATION_INVOICE_KEYS_PATH=/secure/core/service.invoice-keys.json
CORE_BACKUP_INTERVAL_MS=21600000
CORE_BACKUP_KEEP=7
