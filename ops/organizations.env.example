# Separate organization service. Public values only; no wallet key is needed.
CORE_ORGANIZATION_ORIGIN=https://organization-api.example.com
CORE_ORGANIZATION_ALLOWED_ORIGINS=https://core-private-settlement-0574c4.jiheon6768.chatgpt.site
CORE_ORGANIZATION_RPC_URL=https://rpc.testnet.near.org
# Optional standalone Caddy HTTPS profile.
CORE_ORGANIZATION_DOMAIN=organization-api.example.com
CORE_ORGANIZATION_TLS_EMAIL=operator@example.com

# Optional signed payment webhooks; callbacks must be exact approved HTTPS origins.
# CORE_WEBHOOK_ALLOWED_ORIGINS=https://merchant.example
# CORE_WEBHOOK_INDEX_DIRECTORY=/absolute/core-service-data
# CORE_WEBHOOK_POLICY_PATH=/absolute/reviewed-policy.json
# CORE_WEBHOOK_POLICY_SHA256=INDEPENDENTLY_OBTAINED_SHA256

# Optional Sumsub KYB/KYC overlay. The referenced secret file is never committed.
# CORE_SUMSUB_CONFIG_PATH=/absolute/provider.sumsub-config.json
# For direct Node startup use CORE_SUMSUB_CONFIG_FILE; also provision invoice encryption keys.
