# Read-only API configuration. Supply actual independently verified deployment hashes.
CORE_POLICY_FILE=examples/usdc-policy.template.json
CORE_RPC_URL=https://rpc.testnet.near.org
CORE_API_HOST=127.0.0.1
PORT=3001
CORE_ALLOWED_ORIGINS=http://localhost:3000
# Process-local API protection. Limits use the direct socket peer, never forwarding headers.
CORE_API_MAX_CONCURRENT=2
CORE_API_RATE_POINTS=120
CORE_API_RATE_WINDOW_MS=60000
CORE_API_MAX_CLIENTS=1024
CORE_API_TIMEOUT_MS=15000
CORE_API_MAX_RPC_READS=160
# /readyz always checks an attached index; enable this to also reject a missing index.
CORE_API_REQUIRE_INDEX=false
CORE_API_INDEX_MAX_AGE_MS=60000
CORE_API_INDEX_MAX_LAG_BLOCKS=100
# No wallet secret, note password or proving key belongs in this service.
# Contract checkout used only for local builds/demos, not API request routing.
CORE_CONTRACT_REPO=../Contract
# Legacy SDK example; actual API group comes from CORE_POLICY_FILE.
CORE_CONTRACT=
# Optional local finalized journal index. Run the worker before attaching the read-only API.
CORE_INDEX_DB=data/activity.sqlite
# Optional strict JSON array of public {hash, signer} transaction references; never encrypted notes or keys.
CORE_INDEX_TX_REFS=
CORE_INDEX_INTERVAL_MS=5000
# Optional automatic all-shard discovery: set to a reviewed existing block at/before originating transactions.
# CORE_DISCOVERY_START_HEIGHT=

# Optional private organization invoice storage (separate owner-only key file; never inline keys)
# CORE_ORGANIZATION_INVOICE_KEYS_FILE=/absolute/private/service.invoice-keys.json
